#!/usr/bin/python3
"""Root D-Bus shutdown broker. Never force or lazily unmount encrypted volumes."""
from pathlib import Path
import fcntl,hashlib,json,os,pwd,runpy,subprocess,sys,tempfile,threading,time
from gi.repository import Gio,GLib

NAME='org.debianlive.SafePower'
PATH='/org/debianlive/SafePower'
LOGIN='org.freedesktop.login1'
INTERFACE='''<node><interface name="org.debianlive.SafePower">
<method name="Request"><arg name="operation" type="s" direction="in"/><arg name="ok" type="b" direction="out"/><arg name="message" type="s" direction="out"/></method>
<method name="Status"><arg name="json" type="s" direction="out"/></method>
<method name="PrepareCodexRuntime"><arg name="store" type="s" direction="in"/></method>
</interface></node>'''

RAM=Path('/run/live-codex-runtime')
BINDINGS={}
LOCK=threading.RLock()

def proc_identity(pid):
    try:return Path('/proc',str(pid),'stat').read_text().rsplit(')',1)[1].split()[19]
    except (OSError,IndexError):return None

def save_bindings():
    fd,name=tempfile.mkstemp(dir=RAM,prefix='.registry-')
    with os.fdopen(fd,'w') as stream:json.dump(BINDINGS,stream)
    os.replace(name,RAM/'registry.json')

def cleanup_bindings(attempt=False):
    errors=[]
    with LOCK:
        for target,data in list(BINDINGS.items()):
            alive=any(proc_identity(pid)==identity for pid,identity in data['clients'].items())
            if alive and not attempt:continue
            if os.path.ismount(target):
                result=subprocess.run(['umount',target],text=True,capture_output=True,timeout=10)
                if result.returncode:errors.append(result.stderr.strip());continue
            del BINDINGS[target]
        save_bindings()
    return errors

def prepare_runtime(store,pid):
    detector=runpy.run_path('/usr/local/bin/live-vc-apps',run_name='vc_mount_detector')
    mounts=detector['mounts']()
    path=Path(store)
    allowed=[Path(item['target'])/'APP/Codex/state' for item in mounts.values()]
    if path not in allowed or path.resolve()!=path:raise ValueError('Invalid encrypted Codex path')
    target=path/'tmp'
    if target.is_symlink():raise ValueError('Linked runtime path')
    target.mkdir(mode=0o700,exist_ok=True)
    with LOCK:
        key=str(target)
        if key not in BINDINGS:
            if os.path.ismount(target):raise ValueError('Unrecognized runtime mount')
            ram=RAM/hashlib.sha256(key.encode()).hexdigest()[:24]
            ram.mkdir(mode=0o700,exist_ok=True);os.chown(ram,1000,1000)
            subprocess.run(['mount','--bind',str(ram),key],check=True,timeout=10)
            BINDINGS[key]={'ram':str(ram),'clients':{}}
        identity=proc_identity(pid)
        if identity is None:raise ValueError('Client exited')
        BINDINGS[key]['clients'][str(pid)]=identity
        save_bindings()

def volumes():
    found=[]
    for node in Path('/sys/class/block').glob('dm-*'):
        try:name=(node/'dm/name').read_text().strip()
        except OSError:continue
        if name.startswith('veracrypt') and name[9:].isdigit():found.append('/dev/mapper/'+name)
    return sorted(found)

def dismount():
    before=volumes()
    if not before:return True,'암호화 볼륨이 없습니다.'
    subprocess.run(['sync'],check=True,timeout=30)
    runtime_errors=cleanup_bindings(attempt=True)
    if runtime_errors:return False,'Codex가 실행 중이어서 종료를 취소했습니다. Codex를 닫고 다시 시도하세요. '+ ' '.join(runtime_errors)[-600:]
    errors=[]
    try:
        result=subprocess.run(['/usr/bin/veracrypt','--text','--non-interactive','--dismount'],text=True,capture_output=True,timeout=120)
        if result.returncode:errors.append(result.stderr.strip() or result.stdout.strip() or 'VeraCrypt dismount failed')
    except subprocess.SubprocessError as error:errors.append(str(error))
    remaining=volumes()
    if remaining:
        return False,'암호화 볼륨을 해제하지 못해 종료를 취소했습니다. 앱·터미널·파일을 닫고 다시 시도하세요. '+', '.join(remaining)+' '+ ' '.join(errors)[-1000:]
    subprocess.run(['sync'],check=True,timeout=30)
    return True,'암호화 볼륨을 모두 해제했습니다.'

class Broker:
    def __init__(self,bus):
        self.bus=bus;self.fd=None;self.busy=False;self.last={}
        self.inhibit()
        RAM.mkdir(mode=0o755,exist_ok=True)
        if (RAM/'registry.json').is_file():BINDINGS.update(json.loads((RAM/'registry.json').read_text()))
        GLib.timeout_add_seconds(1,self.cleanup)
        bus.register_object(PATH,Gio.DBusNodeInfo.new_for_xml(INTERFACE).interfaces[0],self.call,None,None)

    def cleanup(self):
        if not self.busy:
            try:cleanup_bindings()
            except Exception as error:print('Runtime cleanup: '+str(error),flush=True)
        return True

    def inhibit(self):
        reply,fds=self.bus.call_with_unix_fd_list_sync(LOGIN,'/org/freedesktop/login1',LOGIN+'.Manager','Inhibit',
          GLib.Variant('(ssss)',('shutdown','VeraCrypt 종료 보호','암호화 볼륨 해제 확인 후 종료','block')),
          GLib.VariantType.new('(h)'),Gio.DBusCallFlags.NONE,10000,None,None)
        self.fd=fds.get(reply.unpack()[0])

    def permitted(self,sender):
        uid=self.bus.call_sync('org.freedesktop.DBus','/org/freedesktop/DBus','org.freedesktop.DBus',
          'GetConnectionUnixUser',GLib.Variant('(s)',(sender,)),GLib.VariantType.new('(u)'),0,5000,None).unpack()[0]
        return uid in (0,1000)

    def call(self,bus,sender,path,interface,method,parameters,invocation):
        if method=='Status':invocation.return_value(GLib.Variant('(s)',(json.dumps(self.last),)));return
        if method=='PrepareCodexRuntime':
            if not self.permitted(sender) or self.busy:
                invocation.return_dbus_error(NAME+'.Denied','Shutdown in progress or access denied');return
            try:
                pid=self.bus.call_sync('org.freedesktop.DBus','/org/freedesktop/DBus','org.freedesktop.DBus',
                  'GetConnectionUnixProcessID',GLib.Variant('(s)',(sender,)),None,0,5000,None).unpack()[0]
                prepare_runtime(parameters.unpack()[0],pid)
                invocation.return_value(None)
            except Exception as error:invocation.return_dbus_error(NAME+'.RuntimeFailed',str(error))
            return
        operation=parameters.unpack()[0]
        if not self.permitted(sender) or operation not in ('poweroff','reboot','check'):
            invocation.return_dbus_error(NAME+'.Denied','요청을 허용하지 않습니다.');return
        if self.busy:invocation.return_value(GLib.Variant('(bs)',(False,'이미 암호화 볼륨 해제를 확인하고 있습니다.')));return
        self.busy=True
        started=time.monotonic()
        def worker():
            try:
                account=pwd.getpwuid(1000)
                # Commit selected desktop preferences before attempting dismounts.
                subprocess.run(['runuser','-u',account.pw_name,'--','env','HOME='+account.pw_dir,
                  'XDG_RUNTIME_DIR=/run/user/1000','DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus',
                  '/usr/local/bin/live-profile','save'],capture_output=True,timeout=15)
                ok,message=dismount()
            except Exception as error:ok,message=False,'종료 확인 실패: '+str(error)
            if time.monotonic()-started>150:
                ok,message=False,'해제 확인 시간이 초과되어 종료를 취소했습니다. 상태를 확인한 뒤 다시 시도하세요.'
            GLib.idle_add(self.finish,invocation,operation,ok,message)
        threading.Thread(target=worker,daemon=True).start()

    def finish(self,invocation,operation,ok,message):
        self.last={'operation':operation,'ok':ok,'message':message,'remaining':volumes(),'time':time.time()}
        self.busy=False
        invocation.return_value(GLib.Variant('(bs)',(ok,message)))
        if ok and operation!='check':GLib.timeout_add(500,self.power,operation)
        return False

    def power(self,operation):
        # Recheck immediately before releasing the inhibitor.
        if volumes():self.last={'ok':False,'message':'새 암호화 볼륨이 연결되어 종료를 취소했습니다.'};return False
        os.close(self.fd);self.fd=None
        try:
            self.bus.call_sync(LOGIN,'/org/freedesktop/login1',LOGIN+'.Manager',
              'PowerOff' if operation=='poweroff' else 'Reboot',GLib.Variant('(b)',(False,)),None,0,20000,None)
        except GLib.Error as error:
            self.inhibit();self.last={'ok':False,'message':str(error)}
        return False

def main():
    bus=Gio.bus_get_sync(Gio.BusType.SYSTEM,None)
    broker=Broker(bus)
    Gio.bus_own_name_on_connection(bus,NAME,Gio.BusNameOwnerFlags.NONE,None,None)
    GLib.MainLoop().run()

if __name__=='__main__':main()
