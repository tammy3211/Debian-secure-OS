#!/bin/sh
# Read-only classifier. Never run blockdev here (also safe for udev test).
set -eu
case "${1-}" in sd[a-z]*|nvme[0-9]*n[0-9]*|mmcblk[0-9]*) ;; *) exit 0 ;; esac
base=${LIVE_DISK_SYSFS:-/sys}
path=$(readlink -f "$base/class/block/$1") || exit 0
[ -d "$path" ] || exit 0
# USB SSDs frequently report removable=0; exclude by topology first.
case "$path" in */usb[0-9]*/*) exit 0 ;; esac
if [ -f "$path/partition" ]; then path=${path%/*}; fi
[ -r "$path/removable" ] || exit 0
[ "$(cat "$path/removable")" = 0 ] || exit 0
printf 'protect\n'
