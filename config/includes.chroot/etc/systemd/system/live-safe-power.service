[Unit]
Description=Require VeraCrypt dismount before normal desktop shutdown
After=systemd-logind.service dbus.service
Before=display-manager.service

[Service]
Type=dbus
BusName=org.debianlive.SafePower
ExecStart=/usr/local/sbin/live-safe-power
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
